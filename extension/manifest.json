{
  "manifest_version": 3,
  "name": "Page Katamari",
  "version": "1.9.0",
  "description": "Turn the current webpage into a playground. Roll, collect its words and images, then restore the page.",
  "permissions": ["activeTab", "scripting"],
  "icons": { "16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "action": {
    "default_icon": { "16": "assets/icon-16.png", "48": "assets/icon-48.png" },
    "default_title": "Page Katamari",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-katamari": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Start or stop Page Katamari"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/Manrope-VariableFont_wght.ttf"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ]
}
